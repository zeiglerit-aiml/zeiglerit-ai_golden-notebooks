   "source": [
    "x = np.linspace(-5, 5, 200)\n",
    "plt.plot(x, np.vectorize(gelu)(x)); plt.title('GELU (tanh approximation)'); plt.grid(alpha=.2); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b741797a",
   "metadata": {},
   "source": [
    "#### Softmax\n",
    "\n",
    "Converts a vector of logits into class probabilities that sum to one; commonly used in multiclass output layers."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0135e0ff",
   "metadata": {},
   "outputs": [],
   "source": [
    "import math\n",
    "\n",
    "def softmax(values):\n",
    "    shifted = [v-max(values) for v in values]\n",
    "    exponentials = [math.exp(v) for v in shifted]\n",
    "    return [v/sum(exponentials) for v in exponentials]\n",
    "\n",
    "print('Softmax probabilities:', softmax([2.2, 0.4, -0.7]))"